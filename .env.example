# ─── Database ───────────────────────────────────────────────
# Neon Postgres connection string. For local dev a Docker Postgres works too:
#   docker run --name edulm-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edulm?schema=public"

# ─── Auth.js v5 ─────────────────────────────────────────────
# Generate with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-32-bytes-of-random-hex"

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=""
AUTH_EMAIL_FROM="noreply@edulm.app"

# ─── App URLs ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="edulm.app"

# ─── Internal escape hatches (leave empty unless you know what you're doing) ──
ALLOW_UNSCOPED_QUERIES="false"
