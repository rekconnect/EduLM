# ─── Database ───────────────────────────────────────────────
# Neon Postgres connection string. For local dev a Docker Postgres works too:
#   docker run --name edulm-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edulm?schema=public"

# ─── Auth.js v5 ─────────────────────────────────────────────
# Generate with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-32-bytes-of-random-hex"

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=""
AUTH_EMAIL_FROM="noreply@edulm.app"

# ─── Supabase Storage (for document portal uploads) ─────────
# Get these from Supabase Dashboard → Project Settings → API.
# Service-role key is sensitive — never expose to the browser.
# Bucket: create a private bucket named "documents" in Supabase Storage.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# ─── Bot check on public forms (Cloudflare Turnstile, free) ──
# Create a widget at https://dash.cloudflare.com → Turnstile (add every
# hostname the sign-up runs on, e.g. edulm-alpha.vercel.app). Leave BOTH empty
# to run without the check (local dev). Cloudflare's test keys always pass:
#   TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Scheduled jobs (Vercel Cron, see vercel.json) ───────────
# Random string of 16+ letters/digits. Vercel sends it as
# `Authorization: Bearer …` when it calls /api/cron/*. Leave empty and every
# cron route answers 401 — the automatic purge of abandoned sign-ups
# (Settings → Formulaires) then never runs. Production only.
CRON_SECRET=""

# ─── App URLs ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="edulm.app"

# ─── Internal escape hatches (leave empty unless you know what you're doing) ──
ALLOW_UNSCOPED_QUERIES="false"
