// EduLM — multi-tenant school management SaaS
// Shared DB, shared schema; every tenant-scoped table carries `tenantId`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Tenancy & auth ─────────────────────────

enum TenantPlan {
  TRIAL
  STARTER
  GROWTH
  CUSTOM
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model Tenant {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  defaultLocale  String     @default("fr")
  enabledLocales String[]   @default(["fr"])
  plan           TenantPlan @default(TRIAL)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  users            User[]
  academicYears    AcademicYear[]
  classes          Class[]
  students         Student[]
  guardians        Guardian[]
  enrollments      Enrollment[]
  attendance       AttendanceRecord[]
  disciplineEvents DisciplineEvent[]
  invoices         Invoice[]
  payments         Payment[]
  admissionCycles  AdmissionCycle[]
  applications     Application[]
  documents        TenantDocument[]
  announcements    Announcement[]
  contactMessages  ContactMessage[]
}

model User {
  id            String     @id @default(cuid())
  tenantId      String?
  email         String
  passwordHash  String?
  role          Role
  locale        String?
  status        UserStatus @default(INVITED)
  emailVerified DateTime?
  name          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardianProfile    Guardian?
  disciplineReports  DisciplineEvent[] @relation("DisciplineReporter")
  recordedPayments   Payment[]         @relation("PaymentRecorder")
  sessions           Session[]
  accounts           Account[]
  submittedApps      Application[]     @relation("ApplicationSubmitter")
  reviewedApps       Application[]     @relation("ApplicationReviewer")
  uploadedDocs       TenantDocument[]  @relation("DocumentUploader")
  documentAcks       DocumentAcknowledgment[]
  publishedAnnouncements Announcement[] @relation("AnnouncementPublisher")
  announcementReads  AnnouncementRead[]
  sentMessages       ContactMessage[]  @relation("ContactSender")
  readMessages       ContactMessage[]  @relation("ContactReader")

  @@unique([tenantId, email])
  @@index([tenantId])
}

// Auth.js adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────── Academic structure ─────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  tenantId  String
  label     String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes       Class[]
  enrollments   Enrollment[]
  invoices      Invoice[]
  documents     TenantDocument[]
  announcements Announcement[]

  @@unique([tenantId, label])
  @@index([tenantId])
}

model Class {
  id             String @id @default(cuid())
  tenantId       String
  academicYearId String
  level          String
  section        String
  name           String

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  documents     TenantDocument[]
  announcements Announcement[]

  @@unique([tenantId, academicYearId, level, section])
  @@index([tenantId, academicYearId])
}

// ───────────────────────── People ─────────────────────────

enum StudentStatus {
  PROSPECT
  ENROLLED
  WITHDRAWN
  GRADUATED
}

model Student {
  id            String        @id @default(cuid())
  tenantId      String
  firstName     String
  lastName      String
  dob           DateTime?
  gender        ChildGender?
  nationality   String?
  placeOfBirth  String?
  // Contact / address (the family address; mirrored on Student for now —
  // could be moved to a Family entity later if needed)
  address       String?
  city          String?
  postalCode    String?
  country       String?
  // Misc
  previousSchool   String?
  emergencyContact String?
  internalNotes    String?   // admin-only notes, not shown to parents
  photoUrl         String?
  status           StudentStatus @default(PROSPECT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant                   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardianLinks            StudentGuardian[]
  enrollments              Enrollment[]
  attendance               AttendanceRecord[]
  disciplineEvents         DisciplineEvent[]
  invoices                 Invoice[]
  originApplication        Application?
  renewalApplications      Application[]      @relation("StudentRenewal")

  @@index([tenantId, lastName, firstName])
}

model Guardian {
  id       String  @id @default(cuid())
  tenantId String
  userId   String  @unique
  relation String?

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  childLinks StudentGuardian[]

  @@index([tenantId])
}

model StudentGuardian {
  studentId  String
  guardianId String
  isPrimary  Boolean @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Enrollment {
  id             String   @id @default(cuid())
  tenantId       String
  studentId      String
  classId        String
  academicYearId String
  enrolledAt     DateTime @default(now())
  withdrawnAt    DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([tenantId, academicYearId])
  @@index([tenantId, classId])
}

// ───────────────────────── Attendance & discipline ─────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  tenantId    String
  studentId   String
  date        DateTime         @db.Date
  status      AttendanceStatus
  lateMinutes Int?
  note        String?
  createdAt   DateTime         @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId, date])
}

enum DisciplineSeverity {
  NOTE
  WARNING
  DETENTION
  SUSPENSION
}

model DisciplineEvent {
  id           String             @id @default(cuid())
  tenantId     String
  studentId    String
  type         String
  severity     DisciplineSeverity
  description  String
  reportedById String
  date         DateTime           @default(now())

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("DisciplineReporter", fields: [reportedById], references: [id])

  @@index([tenantId, studentId])
  @@index([tenantId, date])
}

// ───────────────────────── Billing ─────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  studentId      String
  academicYearId String
  number         String
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  totalCents     Int
  currency       String        @default("USD")
  status         InvoiceStatus @default(DRAFT)
  notes          String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  amountCents Int
  quantity    Int    @default(1)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  invoiceId     String
  amountCents   Int
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  recordedById  String
  reference     String?
  notes         String?

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([tenantId, invoiceId])
  @@index([tenantId, paidAt])
}

// ───────────────────────── Admissions / nouvelle inscription ─────────────────────────

model AdmissionCycle {
  id                  String   @id @default(cuid())
  tenantId            String
  label               String
  targetYearLabel     String
  openAt              DateTime @default(now())
  closeAt             DateTime?
  inscriptionFeeCents Int?     @default(0)
  currency            String   @default("USD")
  isActive            Boolean  @default(true)
  description         String?
  createdAt           DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([tenantId, label])
  @@index([tenantId, isActive])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ACCEPTED
  WAITLISTED
  DECLINED
  WITHDRAWN
}

enum ChildGender {
  MALE
  FEMALE
  OTHER
}

model Application {
  id                String            @id @default(cuid())
  tenantId          String
  cycleId           String
  submittedByUserId String
  status            ApplicationStatus @default(DRAFT)

  // Child identity (Step 1)
  childFirstName    String
  childLastName     String
  childDob          DateTime?
  childGender       ChildGender?
  childNationality  String?
  childPlaceOfBirth String?

  // Family (Step 2)
  primaryParentName    String
  primaryParentPhone   String?
  primaryParentEmail   String?
  secondaryParentName  String?
  secondaryParentPhone String?
  secondaryParentEmail String?
  address              String?
  city                 String?
  postalCode           String?
  country              String?

  // Academic history (Step 3)
  currentSchool   String?
  currentLevel    String?
  requestedLevel  String?
  motivationNote  String?

  // Internal notes (admin-only)
  internalNotes   String?

  // Renewal: if set, this is a re-inscription for an existing Student.
  // The accept handler skips Student creation and just creates a new Enrollment
  // in the chosen class for the target year.
  existingStudentId String?

  // Workflow
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  decisionAt         DateTime?
  decisionNote       String?
  resultingStudentId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle            AdmissionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  submittedBy      User           @relation("ApplicationSubmitter", fields: [submittedByUserId], references: [id])
  reviewedBy       User?          @relation("ApplicationReviewer", fields: [reviewedByUserId], references: [id])
  resultingStudent Student?       @relation(fields: [resultingStudentId], references: [id])
  existingStudent  Student?       @relation("StudentRenewal", fields: [existingStudentId], references: [id])

  @@unique([cycleId, existingStudentId])
  @@index([tenantId, cycleId, status])
  @@index([tenantId, submittedByUserId])
  @@index([tenantId, status, submittedAt])
  @@index([tenantId, existingStudentId])
}

// ───────────────────────── Document portal ─────────────────────────

enum DocumentCategory {
  REGULATION   // règlement intérieur
  CALENDAR     // calendrier scolaire
  FORM         // formulaires
  NEWSLETTER   // lettre d'information
  OTHER
}

enum DocumentAudience {
  ALL_PARENTS
  CLASS
  ACADEMIC_YEAR
}

model TenantDocument {
  id               String           @id @default(cuid())
  tenantId         String
  title            String
  description      String?
  category         DocumentCategory @default(OTHER)
  storagePath      String?          // Supabase Storage object key
  externalUrl      String?          // Fallback when storage isn't wired
  fileSizeBytes    Int?
  mimeType         String?
  audience         DocumentAudience @default(ALL_PARENTS)
  classId          String?
  academicYearId   String?
  requiresAck      Boolean          @default(false)
  publishedAt      DateTime         @default(now())
  unpublishedAt    DateTime?
  uploadedByUserId String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class           Class?                   @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicYear    AcademicYear?            @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  uploadedBy      User                     @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  acknowledgments DocumentAcknowledgment[]

  @@index([tenantId, publishedAt])
  @@index([tenantId, category])
  @@index([tenantId, classId])
  @@index([tenantId, academicYearId])
}

model DocumentAcknowledgment {
  id             String   @id @default(cuid())
  documentId     String
  userId         String
  acknowledgedAt DateTime @default(now())

  document TenantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

// ───────────────────────── Communication ─────────────────────────

enum AnnouncementAudience {
  ALL_PARENTS
  CLASS
  ACADEMIC_YEAR
}

model Announcement {
  id                String               @id @default(cuid())
  tenantId          String
  title             String
  body              String
  audience          AnnouncementAudience @default(ALL_PARENTS)
  classId           String?
  academicYearId    String?
  publishedAt       DateTime             @default(now())
  publishedByUserId String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class        Class?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?      @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  publishedBy  User               @relation("AnnouncementPublisher", fields: [publishedByUserId], references: [id])
  reads        AnnouncementRead[]

  @@index([tenantId, publishedAt])
  @@index([tenantId, classId])
  @@index([tenantId, academicYearId])
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

enum ContactMessageStatus {
  NEW
  READ
  CLOSED
}

model ContactMessage {
  id           String               @id @default(cuid())
  tenantId     String
  fromUserId   String
  subject      String
  body         String
  status       ContactMessageStatus @default(NEW)
  readAt       DateTime?
  readByUserId String?
  closedAt     DateTime?
  adminReply   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromUser User   @relation("ContactSender", fields: [fromUserId], references: [id])
  readBy   User?  @relation("ContactReader", fields: [readByUserId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, fromUserId])
}
