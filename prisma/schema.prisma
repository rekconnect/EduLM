// EduLM — multi-tenant school management SaaS
// Shared DB, shared schema; every tenant-scoped table carries `tenantId`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Tenancy & auth ─────────────────────────

enum TenantPlan {
  TRIAL
  STARTER
  GROWTH
  CUSTOM
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model Tenant {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  defaultLocale  String     @default("fr")
  enabledLocales String[]   @default(["fr"])
  plan           TenantPlan @default(TRIAL)
  // Per-tenant brand override. Stored as CSS color strings (hex or oklch()).
  // Threaded into the live app via .tenant-scope in globals.css. Nullable —
  // falls back to the platform's default sky-blue (palette B) when unset.
  brandLight     String?
  brandDark      String?
  logoUrl        String?
  // Contact / location info — shown on emails, invoice footers, public pages.
  address        String?
  phone          String?
  contactEmail   String?
  websiteUrl     String?
  timeZone       String     @default("Europe/Paris")
  // Billing defaults — pre-fill new invoices and admission cycle fees.
  defaultCurrency             String  @default("EUR")
  defaultInvoiceDueOffsetDays Int     @default(30)
  invoiceFooterText           String?
  invoiceNumberPrefix         String?
  invoiceNumberPadding        Int     @default(0)
  // Email notifications — override the platform default sender identity.
  emailSenderName String?
  emailSignature  String?
  // Family code config — auto-generated unique code per family in this tenant.
  // Format: `{familyCodePrefix}{paddedSequence}`, e.g. "F-0001". Sequence is
  // incremented atomically when a new family is created.
  familyCodePrefix       String?
  familyCodePadding      Int     @default(4)
  familyCodeNextSequence Int     @default(1)
  // Per-tenant custom field configs for the Parent and Student profiles.
  // Same shape as CycleFieldConfig — built-in field visibility toggles plus
  // admin-defined custom questions, label overrides, order, categories.
  // Wired into the application wizard AND the parent/student admin forms,
  // so answers captured during inscription land on the persistent profile.
  parentFieldsConfig  Json @default("{}")
  studentFieldsConfig Json @default("{}")
  // Controls the /admin/parents/new form: which built-in fields are
  // shown (firstName / lastName / relation / locale — email + password
  // are always required) and any extra custom questions to ask up front.
  // Stored as { builtin: { firstName: "required"|"optional"|"hidden", … },
  //             categories: […], fields: […] } using the entity-fields
  // schema for the custom side.
  parentCreateFieldsConfig Json @default("{}")
  // Which of the 10 dossier tabs are visible to parents on this tenant.
  // Stored as { eleve: bool, responsables: bool, foyer: bool, scolarite: bool,
  // sante: bool, transport: bool, contacts: bool, finance: bool,
  // justificatifs: bool, validation: bool }. Defaults applied in code so
  // tenants pre-dating this column still see the right tabs.
  inscriptionTabsConfig    Json @default("{}")
  // Per-tenant overrides for the 10-tab inscription dossier's HARDCODED
  // fields — label per locale, required toggle, hidden toggle. Sparse:
  // only diverging keys are stored, resetting a field deletes its key
  // from the JSON. See src/lib/inscription-fields-resolver.ts for the
  // typed shape (TenantInscriptionFormConfig). Distinct from the
  // *FieldsConfig columns above (which configure tenant custom fields).
  inscriptionFormConfig    Json @default("{}")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  users            User[]
  academicYears    AcademicYear[]
  classes          Class[]
  students         Student[]
  guardians        Guardian[]
  families         Family[]
  establishments   Establishment[]
  enrollments      Enrollment[]
  attendance       AttendanceRecord[]
  disciplineEvents DisciplineEvent[]
  invoices         Invoice[]
  payments         Payment[]
  admissionCycles  AdmissionCycle[]
  applications     Application[]
  documents        TenantDocument[]
  announcements    Announcement[]
  contactMessages  ContactMessage[]
  applicationResponsables ApplicationResponsable[]
  applicationContacts     ApplicationContact[]
  applicationSiblings     ApplicationSibling[]
  inscriptionFormAuditLog TenantConfigAuditLog[]
  medicalRecords          StudentMedicalRecord[]
  immunizations           StudentImmunization[]
  medicalVisits           MedicalVisit[]
  busAttendances          BusAttendance[]
  autocars                Autocar[]
  busCircuits             BusCircuit[]
}

model User {
  id            String     @id @default(cuid())
  tenantId      String?
  email         String
  passwordHash  String?
  role          Role
  locale        String?
  status        UserStatus @default(INVITED)
  // When true, the user is forced to set a new password on next login
  // (the (app) layout redirects them to /change-password until cleared).
  // Set for bulk-onboarded parents who start on a shared default password.
  mustChangePassword Boolean @default(false)
  emailVerified DateTime?
  // `name` is kept as the legacy/display fallback (used by NextAuth session
  // and old code paths). firstName/lastName are the editable canonical fields
  // going forward. UI components prefer firstName + lastName when both set.
  name          String?
  firstName     String?
  lastName      String?
  // Per-tenant custom field answers — stored as { [fieldKey]: value }.
  // Populated from application forms on accept, edited from the parent admin
  // detail page. Field definitions live on Tenant.parentFieldsConfig.
  customAnswers Json       @default("{}")
  // Admin three-state lifecycle (only meaningful for PARENT users in the
  // parents-admin list — TEACHER/ADMIN rows always stay active):
  //  - active (archived=false, deletedAt=null)
  //  - archived (archived=true, deletedAt=null)
  //  - deleted (deletedAt!=null) → soft tombstone, restorable
  archived      Boolean    @default(false)
  archivedAt    DateTime?
  deletedAt     DateTime?
  // Dars migration external key — the Isc_Parent.ID_Parent this user was
  // imported from. Lets the importer upsert idempotently (re-run safe).
  // Null for users created natively in EduLM.
  darsParentId  Int?       @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardianProfile    Guardian?
  disciplineReports  DisciplineEvent[] @relation("DisciplineReporter")
  recordedPayments   Payment[]         @relation("PaymentRecorder")
  sessions           Session[]
  accounts           Account[]
  submittedApps      Application[]     @relation("ApplicationSubmitter")
  reviewedApps       Application[]     @relation("ApplicationReviewer")
  uploadedDocs       TenantDocument[]  @relation("DocumentUploader")
  documentAcks       DocumentAcknowledgment[]
  publishedAnnouncements Announcement[] @relation("AnnouncementPublisher")
  announcementReads  AnnouncementRead[]
  sentMessages       ContactMessage[]  @relation("ContactSender")
  readMessages       ContactMessage[]  @relation("ContactReader")
  inscriptionFormAuditEntries TenantConfigAuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// Auth.js adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────── Academic structure ─────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  tenantId  String
  label     String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes       Class[]
  enrollments   Enrollment[]
  invoices      Invoice[]
  documents     TenantDocument[]
  announcements Announcement[]

  @@unique([tenantId, label])
  @@index([tenantId])
}

model Class {
  id             String @id @default(cuid())
  tenantId       String
  academicYearId String
  level          String
  section        String
  name           String
  // Dars migration external key — Isc_Classes.ID_Class. Used by the
  // Phase-2 enrollment importer to match Dars enrollments to the
  // already-seeded EduLM classes. Null for natively-created classes.
  darsClassId    Int?             @unique

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  documents     TenantDocument[]
  announcements Announcement[]

  @@unique([tenantId, academicYearId, level, section])
  @@index([tenantId, academicYearId])
}

// ───────────────────────── People ─────────────────────────

enum StudentStatus {
  PROSPECT
  ENROLLED
  WITHDRAWN
  GRADUATED
}

model Student {
  id            String        @id @default(cuid())
  tenantId      String
  familyId      String?
  firstName     String
  lastName      String
  dob           DateTime?
  gender        ChildGender?
  nationality   String?
  placeOfBirth  String?
  // Contact / address (the family address; mirrored on Student for now —
  // could be moved to a Family entity later if needed)
  address       String?
  city          String?
  postalCode    String?
  country       String?
  // Misc
  previousSchool   String?
  emergencyContact String?
  internalNotes    String?   // admin-only notes, not shown to parents
  photoUrl         String?
  // Dars migration external key — Isc_Student.ID_Student. Idempotent
  // upsert anchor. Null for natively-created students.
  darsStudentId    Int?          @unique
  status           StudentStatus @default(PROSPECT)
  // Per-tenant custom field answers — populated from inscription forms on
  // accept, edited from the student admin detail page. Schema lives on
  // Tenant.studentFieldsConfig.
  customAnswers    Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant                   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family                   Family?            @relation(fields: [familyId], references: [id], onDelete: SetNull)
  guardianLinks            StudentGuardian[]
  enrollments              Enrollment[]
  attendance               AttendanceRecord[]
  disciplineEvents         DisciplineEvent[]
  invoices                 Invoice[]
  originApplication        Application?
  renewalApplications      Application[]      @relation("StudentRenewal")
  medicalRecord            StudentMedicalRecord?
  immunizations            StudentImmunization[]
  medicalVisits            MedicalVisit[]
  busAttendances           BusAttendance[]

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, familyId])
}

// ───────────────────────── Infirmerie / santé ─────────────────────────

/// One medical record per student — allergies, chronic conditions, consents.
/// Sensitive: only surfaced to SCHOOL_ADMIN (and later a NURSE role), never to
/// teachers or other parents. Imported from Dars Med_History (infirmary-entered)
/// overlaid with Med_HistoryOnline (the parent-filled online form).
model StudentMedicalRecord {
  id        String @id @default(cuid())
  tenantId  String
  studentId String @unique

  bloodType String?
  // Chronic conditions (checkbox set from the Dars form)
  diabetic       Boolean @default(false)
  asthma         Boolean @default(false)
  epilepsy       Boolean @default(false)
  scoliosis      Boolean @default(false)
  favism         Boolean @default(false)
  hemophilia     Boolean @default(false)
  cardiacProblem Boolean @default(false)

  // Free-text clinical info
  allergies       String?
  medications     String?
  hospitalization String?
  surgeries       String?
  majorIllnesses  String?
  chronicIllness  String?
  familyHistory   String?
  specialNeeds    String?
  remarks         String?

  pediatricianName  String?
  pediatricianPhone String?

  // Parental consents (null = not answered)
  allowEmergencyMeasures Boolean?
  allowDoctorExam        Boolean?
  allowParacetamol       Boolean?
  allowMedicalTreatment  Boolean?

  unfitForSports Boolean @default(false)
  unfitDuration  String?
  unfitReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// One row per student per vaccine. Names come from a configurable mapping
/// (Dars hardcodes them in the app); darsImmunizationId keeps the original id
/// so the mapping can be corrected and re-applied.
model StudentImmunization {
  id        String  @id @default(cuid())
  tenantId  String
  studentId String

  vaccine             String
  darsImmunizationId  Int?
  done                Boolean @default(false)
  month               Int?
  year                Int?
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, darsImmunizationId])
  @@index([tenantId, studentId])
}

/// An infirmary visit / periodic checkup. Vitals as columns; the many
/// specialty exam fields (audition, dents, scoliose, poux…) in `details` JSON
/// as label → value, rendered as a list.
model MedicalVisit {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String

  visitDate DateTime
  yearLabel String? // academic year label, e.g. "2025-2026"
  heightCm  Float?
  weightKg  Float?
  bpHigh    String?
  bpLow     String?
  visionOd  String? // right eye
  visionOg  String? // left eye
  exam      String?
  plan      String?
  followUp  String?
  remarks   String?
  details   Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, visitDate])
}

/// Daily bus-run attendance ("app bus"): one status per student per bus per
/// day, set from the Autocars tab. Status: present | absent | retard |
/// depart_autorise | activite.
model BusAttendance {
  id        String @id @default(cuid())
  tenantId  String
  studentId String

  date   String // "YYYY-MM-DD" (local school day)
  bus    String // bus number the attendance was taken on
  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, date, bus])
  @@index([tenantId, date, bus])
}

/// The bus fleet ("Listes des autocars") — managed from the transport module.
model Autocar {
  id       String @id @default(cuid())
  tenantId String

  number           String // bus number as used everywhere (0-24 today)
  type             String? // bus | minibus | van
  capacity         Int?
  plate            String? // plaque d'immatriculation
  cylinders        Int?
  couleur          String?
  dateAchat        String? // "YYYY-MM-DD"
  moteur           String?
  fuel             String? // diesel | essence | hybride | electrique
  modele           String?
  anneeFabrication Int?
  vin              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId])
}

/// "Autocar - Circuit": a circuit run by an autocar — label rendered as
/// "<autocarNumber> - <activite>" (Dars naming, e.g. "8 - Ordinaire").
model BusCircuit {
  id       String @id @default(cuid())
  tenantId String

  autocarNumber String
  activite      String @default("Ordinaire")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, autocarNumber, activite])
  @@index([tenantId])
}

model Guardian {
  id       String  @id @default(cuid())
  tenantId String
  userId   String  @unique
  familyId String?
  relation String?

  // Identity columns — admin can set these even when the parent has
  // no application yet. Mirror to/from Application.submitter* on every
  // edit (either side). monoParental is a family-level concept; living
  // on Guardian means it survives across multiple kids' dossiers.
  isLebanese       Boolean?
  passportLebanese String?
  nationality1     String?
  nationality2     String?
  monoParental     Boolean  @default(false)
  // Primary contact phone (Dars Isc_Parent.Mobile / first Isc_ParentPhone).
  // Mirrored here so admin sees it without an application.
  phone            String?

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  family     Family?           @relation(fields: [familyId], references: [id], onDelete: SetNull)
  childLinks StudentGuardian[]

  @@index([tenantId])
  @@index([familyId])
}

// ───────────────────────── Family ─────────────────────────

/// A Family groups one or more Guardians (parents) and their Students so that
/// shared concerns — billing, family-level documents, the "all my kids" parent
/// portal view, sibling discounts — have a clear anchor. Each family carries a
/// human-readable unique code per tenant (format configurable via
/// Tenant.familyCodePrefix + familyCodePadding), e.g. "F-0042".
model Family {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String?   // optional admin-friendly label, e.g. "Famille El Kady"
  // Dars migration external key — the Isc_Parent.Id_MainParent (root /
  // father) this family was grouped from. Idempotent upsert anchor.
  // Null for families created natively in EduLM.
  darsRootParentId Int? @unique

  // Foyer-level info shared across all the family's children (Page 3 of
  // the Montaigne paper form). When a parent registers a second child
  // we pre-fill this so they don't type it twice.
  addressStreet  String?
  addressHood    String?   // quartier
  addressPostal  String?
  addressCity    String?
  addressCountry String?
  // Image-rights toggles — Montaigne form lists 4 separately rather
  // than the Eduka single "droits à l'image" yes/no.
  imageRightsSite   Boolean?  // site web
  imageRightsBook   Boolean?  // livre souvenir / yearbook
  imageRightsSocial Boolean?  // réseaux sociaux
  imageRightsRadio  Boolean?  // web radio
  imageRightsAnsweredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardians Guardian[]
  students  Student[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ───────────────────────── Establishment ─────────────────────────

/// A school sub-division (Maternelle, Élémentaire, Collège, Lycée …) used to
/// drive the cascading dropdown during inscription: parent picks Établissement,
/// then Niveau options filter to the levels listed here. Admin-managed in
/// /settings. `levels` is a JSON array of level strings (e.g. ["CP","CE1",…]).
model Establishment {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  levels    Json     @default("[]")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model StudentGuardian {
  studentId  String
  guardianId String
  isPrimary  Boolean @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Enrollment {
  id             String   @id @default(cuid())
  tenantId       String
  studentId      String
  classId        String
  academicYearId String
  enrolledAt     DateTime @default(now())
  withdrawnAt    DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([tenantId, academicYearId])
  @@index([tenantId, classId])
}

// ───────────────────────── Attendance & discipline ─────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  tenantId    String
  studentId   String
  date        DateTime         @db.Date
  status      AttendanceStatus
  lateMinutes Int?
  note        String?
  createdAt   DateTime         @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId, date])
}

enum DisciplineSeverity {
  NOTE
  WARNING
  DETENTION
  SUSPENSION
}

model DisciplineEvent {
  id           String             @id @default(cuid())
  tenantId     String
  studentId    String
  type         String
  severity     DisciplineSeverity
  description  String
  reportedById String
  date         DateTime           @default(now())

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("DisciplineReporter", fields: [reportedById], references: [id])

  @@index([tenantId, studentId])
  @@index([tenantId, date])
}

// ───────────────────────── Billing ─────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  studentId      String
  academicYearId String
  number         String
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  totalCents     Int
  currency       String        @default("USD")
  status         InvoiceStatus @default(DRAFT)
  notes          String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  amountCents Int
  quantity    Int    @default(1)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  invoiceId     String
  amountCents   Int
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  recordedById  String
  reference     String?
  notes         String?

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([tenantId, invoiceId])
  @@index([tenantId, paidAt])
}

// ───────────────────────── Admissions / nouvelle inscription ─────────────────────────

/// JSON blob shape (typed in code via `lib/admission-fields.ts`):
/// {
///   fields?: { [fieldKey: string]: "required" | "optional" | "hidden" },
///   customQuestions?: [{ id, type, label, required, ... }],
///   customLabels?: { [fieldKey: string]: string },
///   stepIntros?: { identity?: string, family?: string, academic?: string },
///   fieldOrder?: string[],
/// }
/// Stored as JSON because future rounds (custom questions, label overrides,
/// reorder, templates) all just add new keys without another migration.
model AdmissionCycle {
  id                  String   @id @default(cuid())
  tenantId            String
  label               String
  targetYearLabel     String
  openAt              DateTime @default(now())
  closeAt             DateTime?
  // First day of school for this cycle's target year. Pre-fills the
  // parent's "Date d'entrée souhaitée" on the Scolarité tab — admin
  // sets it once per cycle so every dossier inherits the same date.
  schoolStartDate     DateTime?
  inscriptionFeeCents Int?     @default(0)
  currency            String   @default("USD")
  isActive            Boolean  @default(true)
  description         String?
  fieldConfig         Json     @default("{}")
  createdAt           DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([tenantId, label])
  @@index([tenantId, isActive])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ACCEPTED
  WAITLISTED
  DECLINED
  WITHDRAWN
}

enum ChildGender {
  MALE
  FEMALE
  OTHER
}

model Application {
  id                String            @id @default(cuid())
  tenantId          String
  cycleId           String
  submittedByUserId String
  status            ApplicationStatus @default(DRAFT)

  // Child identity (Step 1)
  childFirstName    String
  childLastName     String
  childDob          DateTime?
  childGender       ChildGender?
  // Montaigne lists "Nationalité Libanaise" as its own Oui/Non
  // question, then up to 2 extra nationalities. Stored separately so
  // admin can filter "Lebanese kids" trivially.
  childIsLebanese   Boolean?
  // Lebanese passport / ID number — only meaningful when
  // childIsLebanese = true; UI hides it otherwise.
  childPassportLebanese String?
  // Up to 2 extra nationalities (the 3rd slot was dropped — the
  // Lebanese passport above replaces it).
  childNationality  String?
  childNationality2 String?
  childNationality3 String?
  // Ville (city) + Pays (country) of birth — Montaigne captures both.
  childPlaceOfBirth String?
  childBirthCountry String?
  // الاسم / الشهرة — Arabic first + last name per the official ID.
  childFirstNameAr  String?
  childLastNameAr   String?
  // مكان الولادة — Arabic place of birth (Montaigne/Dars capture it).
  childPlaceOfBirthAr String?

  // Family (Step 2)
  primaryParentName    String
  primaryParentPhone   String?
  primaryParentEmail   String?
  secondaryParentName  String?
  secondaryParentPhone String?
  secondaryParentEmail String?
  address              String?
  city                 String?
  postalCode           String?
  country              String?

  // Academic history (Step 3)
  currentSchool   String?
  currentLevel    String?
  requestedLevel  String?
  motivationNote  String?

  // Scolarité souhaitée (Round 7) — replaces requestedLevel as the canonical
  // routing info once admin has configured Establishments in /settings.
  // `requestedLevel` is kept for legacy applications and a fallback when no
  // establishments are set up yet.
  establishmentId  String?
  niveau           String?

  // Tenant-level custom field answers (Round 7).
  //   parentAnswers  → captures Tenant.parentFieldsConfig fields filled by parent
  //   studentAnswers → captures Tenant.studentFieldsConfig fields for the child
  // On accept, these are propagated to User.customAnswers / Student.customAnswers
  // so the answers survive on the persistent profile.
  parentAnswers   Json @default("{}")
  studentAnswers  Json @default("{}")

  // ── Dossier (10-tab Eduka-style inscription) ──
  // Family-situation flags coming off the Responsables tab.
  monoParental    Boolean  @default(false)
  // Submitting parent's relation to the child (père / mère / tuteur /
  // grand-père / etc.). Single value for now — Phase 4 will migrate
  // this to per-responsable rows on ApplicationResponsable.
  submitterRelation   String?
  // Lebanese-nationality Oui/Non for the submitting parent + passport
  // number when Yes. Phase 4 migrates to ApplicationResponsable.
  submitterIsLebanese     Boolean?
  submitterPassportLebanese String?
  // Up to 2 other nationalities — mirrors the Élève tab layout.
  submitterNationality   String?
  submitterNationality2  String?

  // Bag of free-form answers used by the dossier tabs that don't have a
  // dedicated column yet (Scolarité antérieure rows, EBEP toggles,
  // pedagogical choices for 2nde/1ère/Tle, transport, restauration,
  // finance acknowledgements, etc.). Each tab namespaces its keys to
  // avoid collisions (e.g. "scolarite.previousYear1.school").
  // Pre-WYSIWYG, the keys are hardcoded in lib/dossier-fields.ts.
  dossierAnswers  Json @default("{}")

  // Per-tab completion flag. Auto-derived from required-field presence
  // at save time and cached here for fast À REMPLIR badge rendering.
  // Shape: { eleve: bool, responsables: bool, foyer: bool, ... }
  tabsCompleted   Json @default("{}")

  // Internal notes (admin-only)
  internalNotes   String?

  // Renewal: if set, this is a re-inscription for an existing Student.
  // The accept handler skips Student creation and just creates a new Enrollment
  // in the chosen class for the target year.
  existingStudentId String?

  // Workflow
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  decisionAt         DateTime?
  decisionNote       String?
  resultingStudentId String?  @unique

  // Three-state lifecycle in the admin list:
  //  - active (archived=false, deletedAt=null) → default view
  //  - archived (archived=true, deletedAt=null) → "Archivés" section
  //  - deleted (deletedAt!=null) → "Supprimés" section, recoverable until
  //    an admin permanently purges it
  archived           Boolean  @default(false)
  archivedAt         DateTime?
  deletedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle            AdmissionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  submittedBy      User           @relation("ApplicationSubmitter", fields: [submittedByUserId], references: [id])
  reviewedBy       User?          @relation("ApplicationReviewer", fields: [reviewedByUserId], references: [id])
  resultingStudent Student?       @relation(fields: [resultingStudentId], references: [id])
  existingStudent  Student?       @relation("StudentRenewal", fields: [existingStudentId], references: [id])
  establishment    Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  answers          ApplicationAnswer[]
  documents        ApplicationDocument[]
  responsables     ApplicationResponsable[]
  contacts         ApplicationContact[]
  siblings         ApplicationSibling[]

  @@unique([cycleId, existingStudentId])
  @@index([tenantId, cycleId, status])
  @@index([tenantId, submittedByUserId])
  @@index([tenantId, status, submittedAt])
  @@index([tenantId, existingStudentId])
}

// ───────────────────────── Dossier sub-models ─────────────────────────
// Phase 1 of the 10-tab Eduka-style inscription. These live on the
// Application (one row per inscription dossier) and capture the rich
// per-tab content that doesn't fit cleanly into a flat key-value bag.

enum ResponsableKind {
  PERE
  MERE
  TUTEUR
  AUTRE
}

/// One row per responsable on the Responsables tab. Montaigne typically
/// has two (Père + Mère); monoparental families flag `Application.monoParental`
/// and use a single row. Tuteur or grand-parent is just `kind = AUTRE`.
///
/// The Lebanese family registry (No. registre + caza + village) only
/// belongs to one parent at a time — `holdsRegistre = true` marks them.
model ApplicationResponsable {
  id            String   @id @default(cuid())
  tenantId      String
  applicationId String

  order         Int             @default(0)
  kind          ResponsableKind @default(AUTRE)
  holdsRegistre Boolean         @default(false)

  // Identity (Latin + Arabic per Montaigne form)
  civility      String?  // Mr / Mme
  lastName      String?
  maidenName    String?  // nom de jeune fille
  firstName     String?
  firstName2    String?
  lastNameAr    String?
  firstNameAr   String?

  // Lebanese-nationality Oui/Non — separate from the dropdowns below
  // because Montaigne asks the question explicitly.
  isLebanese     Boolean?
  // Nationality + passport / ID (up to 2 nationalities like the form)
  nationality1   String?
  nationality2   String?
  passport1No    String?
  passport1Exp   DateTime?
  passport2No    String?
  passport2Exp   DateTime?

  // Contact
  email           String?
  emailPro        String?
  phoneMobile     String?
  phoneHome       String?
  phoneWork       String?
  phonePreferred  String?  // "mobile" | "home" | "work"

  // Family situation + custody (only meaningful when divorced/separated)
  maritalStatus               String?  // marié / divorcé / séparé / veuf / autre
  custody                     String?  // pere / mere / autre
  custodyOther                String?  // free text when "autre"
  financiallyResponsible      String?  // pere / mere / autre
  financiallyResponsibleOther String?

  // Professional info
  employmentStatus  String?  // employed / unemployed / self_employed / retired / other
  profession        String?
  professionDetails String?
  employer          String?
  jobTitle          String?
  workAddress       String?
  workPhone         String?
  diploma           String?  // dernier diplôme

  // Lycée Montaigne extras
  isFormerStudent      Boolean?  // ancien élève du lycée
  allowDirectoryEmail  Boolean?  // accept comité-de-parents email sharing

  // Any tenant-defined extra fields go here.
  customAnswers Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([tenantId])
}

enum ContactKind {
  URGENCE  // personne à prévenir en cas d'urgence
  PICKUP   // personne autorisée à récupérer l'enfant
}

/// "Autres contacts" tab — two stacked lists with identical schema. The
/// UI enforces that contacts are different people than the responsables.
model ApplicationContact {
  id            String      @id @default(cuid())
  tenantId      String
  applicationId String

  kind          ContactKind
  order         Int         @default(0)

  firstName     String
  lastName      String
  relation      String?     // e.g. "grand-père", "oncle", "voisin"
  photoUrl      String?     // optional — Supabase storage path
  phoneMobile   String?
  phoneHome     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([tenantId])
}

/// Sibling rows on the Foyer tab — informational only (siblings already
/// at this school are tracked via Student/Family; this captures siblings
/// at OTHER schools so admin has a complete family picture).
model ApplicationSibling {
  id            String   @id @default(cuid())
  tenantId      String
  applicationId String

  order         Int      @default(0)
  firstName     String
  birthYear     Int?
  className     String?  // current class
  schoolName    String?  // current school

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([tenantId])
}

/// Per-application answers to the cycle's custom questions. The list of
/// questions themselves lives on `AdmissionCycle.fieldConfig.customQuestions`
/// (typed in `lib/admission-fields.ts`). Stored as String — UI coerces by type.
model ApplicationAnswer {
  id            String   @id @default(cuid())
  applicationId String
  questionId    String
  value         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([applicationId])
}

/// Per-application uploaded files for the cycle's required-document list.
/// The requirement metadata (label, accepted types, required-ness) lives on
/// `AdmissionCycle.fieldConfig.requiredDocuments`. Each upload sits in
/// Supabase Storage under `storagePath`.
model ApplicationDocument {
  id            String   @id @default(cuid())
  applicationId String
  requirementId String
  storagePath   String
  filename      String
  mimeType      String
  fileSizeBytes Int
  uploadedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, requirementId])
  @@index([applicationId])
}

// ───────────────────────── Document portal ─────────────────────────

enum DocumentCategory {
  REGULATION   // règlement intérieur
  CALENDAR     // calendrier scolaire
  FORM         // formulaires
  NEWSLETTER   // lettre d'information
  OTHER
}

enum DocumentAudience {
  ALL_PARENTS
  CLASS
  ACADEMIC_YEAR
}

model TenantDocument {
  id               String           @id @default(cuid())
  tenantId         String
  title            String
  description      String?
  category         DocumentCategory @default(OTHER)
  storagePath      String?          // Supabase Storage object key
  externalUrl      String?          // Fallback when storage isn't wired
  fileSizeBytes    Int?
  mimeType         String?
  audience         DocumentAudience @default(ALL_PARENTS)
  classId          String?
  academicYearId   String?
  requiresAck      Boolean          @default(false)
  publishedAt      DateTime         @default(now())
  unpublishedAt    DateTime?
  uploadedByUserId String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class           Class?                   @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicYear    AcademicYear?            @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  uploadedBy      User                     @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  acknowledgments DocumentAcknowledgment[]

  @@index([tenantId, publishedAt])
  @@index([tenantId, category])
  @@index([tenantId, classId])
  @@index([tenantId, academicYearId])
}

model DocumentAcknowledgment {
  id             String   @id @default(cuid())
  documentId     String
  userId         String
  acknowledgedAt DateTime @default(now())

  document TenantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

// ───────────────────────── Communication ─────────────────────────

enum AnnouncementAudience {
  ALL_PARENTS
  CLASS
  ACADEMIC_YEAR
}

model Announcement {
  id                String               @id @default(cuid())
  tenantId          String
  title             String
  body              String
  audience          AnnouncementAudience @default(ALL_PARENTS)
  classId           String?
  academicYearId    String?
  publishedAt       DateTime             @default(now())
  publishedByUserId String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class        Class?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?      @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  publishedBy  User               @relation("AnnouncementPublisher", fields: [publishedByUserId], references: [id])
  reads        AnnouncementRead[]

  @@index([tenantId, publishedAt])
  @@index([tenantId, classId])
  @@index([tenantId, academicYearId])
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

enum ContactMessageStatus {
  NEW
  READ
  CLOSED
}

model ContactMessage {
  id           String               @id @default(cuid())
  tenantId     String
  fromUserId   String
  subject      String
  body         String
  status       ContactMessageStatus @default(NEW)
  readAt       DateTime?
  readByUserId String?
  closedAt     DateTime?
  adminReply   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromUser User   @relation("ContactSender", fields: [fromUserId], references: [id])
  readBy   User?  @relation("ContactReader", fields: [readByUserId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, fromUserId])
}

// ───────────────────────── WYSIWYG audit log ─────────────────────────
// Append-only ledger of every change made via the inscription-form
// editor at /admin/inscription-config/preview. Written from the
// saveFieldOverride + resetFieldOverride server actions. No UI consumes
// it yet — it's data first so we don't lose history. A "Historique des
// modifications" admin view can land later without a migration.

enum TenantConfigAuditAction {
  SET
  RESET
}

model TenantConfigAuditLog {
  id            String                  @id @default(cuid())
  tenantId      String
  /// User who triggered the change (SCHOOL_ADMIN role, enforced in the action).
  userId        String
  /// Registry key from inscription-fields-registry.ts (e.g. "eleve.etatCivil.lastName").
  fieldKey      String
  action        TenantConfigAuditAction
  /// The override that was in place BEFORE this change. Null when the
  /// field had no override (first edit).
  previousValue Json?
  /// The override that's in place AFTER this change. Null for resets.
  newValue      Json?
  createdAt     DateTime                @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, fieldKey, createdAt])
}
