{
  // Standalone typecheck (npm run typecheck / CI): same compiler options as
  // the app, but WITHOUT the .next generated types — the dev server rewrites
  // those continuously and half-written files produce phantom syntax errors
  // (next-env.d.ts imports them, hence the dedicated typecheck-env.d.ts).
  // `next build` still validates the generated types with the main tsconfig.
  "extends": "./tsconfig.json",
  "include": [
    "typecheck-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "prisma/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
